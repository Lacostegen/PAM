<Application x:Class="PragmaticAnalyzer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/WorkspacePalette.xaml" />
                <ResourceDictionary Source="Styles/HyperlinkButtonStyle.xaml" />
                <ResourceDictionary Source="Styles/OutlinedGrayButtonStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedProgressBarStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedComboBoxStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedTextBoxStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedListBoxStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedListBoxItemStyle.xaml" />
                <ResourceDictionary Source="Styles/MainTextBlockStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedTreeViewStyle.xaml" />
                <ResourceDictionary Source="Styles/RoundedTreeViewxItemStyle.xaml" />
                <ResourceDictionary Source="Styles/MainBorderStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button" BasedOn="{StaticResource OutlinedGrayButtonStyle}"/>
            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{StaticResource WorkspaceSurface}"/>
                <Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLine}"/>
                <Setter Property="CaretBrush" Value="{StaticResource WorkspaceAccent}"/>
            </Style>
            <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/></Style>
            <Style TargetType="RadioButton"><Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/></Style>
            <Style TargetType="Expander"><Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/></Style>
            <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/></Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource RoundedComboBoxStyle}"/>
            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="Template"><Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Row" Padding="{TemplateBinding Padding}" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource WorkspaceSelection}"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource WorkspaceRaised}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value></Setter>
            </Style>
            <Style TargetType="ListBox" BasedOn="{StaticResource RoundedListBoxStyle}"/>
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource RoundedListBoxItemStyle}"/>
            <Style TargetType="ToolTip">
                <Style.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <TextBlock MaxWidth="500" TextWrapping="Wrap" Text="{Binding}"/>
                    </DataTemplate>
                </Style.Resources>
                <Setter Property="Background" Value="{StaticResource WorkspaceRaised}"/>
                <Setter Property="Foreground" Value="{StaticResource WorkspaceText}"/>
                <Setter Property="BorderBrush" Value="{StaticResource WorkspaceLine}"/>
                <Setter Property="Padding" Value="8,5"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
