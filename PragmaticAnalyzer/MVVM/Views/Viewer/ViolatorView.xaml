<UserControl x:Class="PragmaticAnalyzer.MVVM.Views.Viewer.ViolatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cc="clr-namespace:PragmaticAnalyzer.CastomControls"
             xmlns:assist="clr-namespace:PragmaticAnalyzer.Assistant"
             xmlns:vmViewer="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Viewer"
             d:DataContext="{d:DesignInstance Type=vmViewer:ViolatorViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="800"
             Loaded="ViolatorView_Loaded">

    <UserControl.Resources>
        <assist:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="SchemeHotspotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#01FFFFFF" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33007ACC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF007ACC" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55007ACC" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="329*" />
            <ColumnDefinition Width="321*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая часть: кнопка схемы + список нарушителей -->
        <ContentControl Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Content="{Binding LocalSearch}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,4,4" />

        <Grid Grid.Row="1"
              Grid.Column="0"
              Margin="5,5,5,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Идентификатор:"
                       Style="{StaticResource MainTextBlockStyle}" />

            <Button x:Name="SchemeToggleButton"
                    Grid.Row="1"
                    Content="Схема модели "
                    Style="{StaticResource OutlinedGrayButtonStyle}"
                    Margin="5,3,5,8"
                    Padding="6,4"
                    Click="ToggleSchemeButton_Click" />

            <ListBox x:Name="ViolatorIdentifiersListBox"
                     Grid.Row="2"
                     ItemsSource="{Binding Violators}"
                     SelectedItem="{Binding SelectedViolator}"
                     Style="{StaticResource RoundedListBoxStyle}"
                     ItemContainerStyle="{StaticResource RoundedListBoxItemStyle}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding GroupName}"
                                   Style="{StaticResource MainTextBlockStyle}"
                                   Margin="1" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Правая часть: карточка нарушителя или схема -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="5,5,5,5"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="6" Grid.ColumnSpan="2">
            <Grid>
                <!-- Режим 1: карточка нарушителя -->
                <ScrollViewer x:Name="ViolatorCardsPanel"
                              Margin="5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              d:Visibility="Collapsed">

                    <WrapPanel Visibility="{Binding SelectedViolator, Converter={StaticResource NullToVisibilityConverter}}">
                        <cc:LabeledValueBox LabelText="Описание"
                                            ValueText="{Binding SelectedViolator.Description}" />

                        <cc:LabeledValueBox LabelText="Государственная принадлежность"
                                            ValueText="{Binding SelectedViolator.StateAffiliation}" />

                        <cc:LabeledValueBox LabelText="Второстепенные названия"
                                            ValueText="{Binding SelectedViolator.AlternateNames}" />

                        <cc:LabeledValueBox LabelText="Объекты атаки"
                                            ValueText="{Binding SelectedViolator.AttackTargets}" />

                        <cc:LabeledValueBox LabelText="Известные атаки"
                                            ValueText="{Binding SelectedViolator.KnownAttacks}" />

                        <cc:LabeledValueBox LabelText="Применяемые инструменты"
                                            ValueText="{Binding SelectedViolator.UsedTools}" />

                        <cc:LabeledValueBox LabelText="Цели атаки"
                                            ValueText="{Binding SelectedViolator.AttackObjectives}" />

                        <cc:LabeledValueBox LabelText="Применяемые тактики"
                                            ValueText="{Binding SelectedViolator.TacticsUsedToString}" />
                    </WrapPanel>
                </ScrollViewer>

                <!-- Режим 2: схема модели нарушителей -->
                <Grid x:Name="ViolatorSchemePanel"
                      Visibility="Collapsed"
                      d:Visibility="Visible"
                      Background="White">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="8"
                               LastChildFill="False">
                        <TextBlock Text="Схема модели нарушителей"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   Style="{StaticResource MainTextBlockStyle}" />

                        <Button Content="Вернуться к карточке"
                                DockPanel.Dock="Right"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Margin="5,0,0,0"
                                Click="HideSchemeButton_Click" />

                        <Button Content="100%"
                                DockPanel.Dock="Right"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Margin="5,0,0,0"
                                Click="ResetSchemeZoomButton_Click" />
                    </DockPanel>

                    <Grid Grid.Row="1"
                          Margin="8,10,8,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="SchemeScrollViewer"
                                      Grid.Column="0"
                                      Margin="0,0,8,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="White"
                                      PreviewMouseWheel="SchemeScrollViewer_PreviewMouseWheel">
                            <Grid x:Name="SchemeZoomRoot"
                                  Width="1777"
                                  Height="919"
                                  RenderOptions.BitmapScalingMode="HighQuality">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="SchemeScaleTransform"
                                                    ScaleX="1"
                                                    ScaleY="1"
                                                    d:ScaleX="0.35"
                                                    d:ScaleY="0.35" />
                                </Grid.LayoutTransform>

                                <Image Source="/Images/ViolatorModelScheme.png"
                                       Width="1777"
                                       Height="919"
                                       Stretch="Fill" Margin="13,2,-13,-2" />

                                <Canvas Width="1777"
                                        Height="919">
                                <!-- Левая красная группа -->
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="30" Canvas.Top="9" Width="105" Height="84" ToolTip="Подрядчики" Tag="Подрядчики" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="171" Canvas.Top="10" Width="106" Height="85" ToolTip="Корпоративные группы" Tag="Корпоративные группы" Click="SchemeNodeButton_Click" RenderTransformOrigin="0.496,0.505" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="336" Canvas.Top="9" Width="106" Height="85" ToolTip="Конкурирующие организации" Tag="Конкурирующие организации" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="30" Canvas.Top="156" Width="105" Height="84" ToolTip="Криминальные сервисы" Tag="Криминальные сервисы" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="171" Canvas.Top="156" Width="106" Height="84" ToolTip="Финансовые группы" Tag="Финансовые группы" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="335" Canvas.Top="156" Width="108" Height="84" ToolTip="Хакерские группировки" Tag="Хакерские группировки" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="29" Canvas.Top="303" Width="106" Height="85" ToolTip="Аналитические центры" Tag="Аналитические центры" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="171" Canvas.Top="303" Width="106" Height="86" ToolTip="Оперативные подразделения" Tag="Оперативные подразделения" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="336" Canvas.Top="303" Width="106" Height="86" ToolTip="Спецслужбы ИГ" Tag="Спецслужбы ИГ" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="22" Canvas.Top="504" Width="108" Height="86" ToolTip="Сообщества" Tag="Сообщества" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="165" Canvas.Top="504" Width="107" Height="86" ToolTip="Независимые" Tag="Независимые" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="336" Canvas.Top="504" Width="106" Height="86" ToolTip="Исследователи, энтузиасты" Tag="Исследователи, энтузиасты" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="23" Canvas.Top="651" Width="107" Height="85" ToolTip="Группы" Tag="Группы" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="166" Canvas.Top="650" Width="106" Height="86" ToolTip="Индивидуальные" Tag="Индивидуальные" Click="SchemeNodeButton_Click" RenderTransformOrigin="0.499,0.504" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="335" Canvas.Top="650" Width="105" Height="86" ToolTip="Хактивисты" Tag="Хактивисты" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="8" Canvas.Top="795" Width="107" Height="86" ToolTip="Сканирующие платформы" Tag="Сканирующие платформы" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="151" Canvas.Top="796" Width="106" Height="85" ToolTip="Ботнеты" Tag="Ботнеты" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="323" Canvas.Top="796" Width="106" Height="85" ToolTip="Автоматизированные атаки" Tag="Автоматизированные атаки" Click="SchemeNodeButton_Click" />

                                <!-- Левый центр -->
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="595" Canvas.Top="339" Width="107" Height="53" ToolTip="Организованные нарушители" Tag="Организованные нарушители" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="595" Canvas.Top="537" Width="107" Height="54" ToolTip="Неорганизованные нарушители" Tag="Неорганизованные нарушители" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="595" Canvas.Top="651" Width="107" Height="85" ToolTip="ИИ-нарушитель" Tag="ИИ-нарушитель" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                <!-- Центр -->
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="733" Canvas.Top="439" Width="95" Height="53" ToolTip="Внешний нарушитель ИБ" Tag="Внешний нарушитель ИБ" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="881" Canvas.Top="439" Width="95" Height="53" ToolTip="Нарушитель ИБ" Tag="Нарушитель ИБ" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1026" Canvas.Top="441" Width="94" Height="51" ToolTip="Внутренний нарушитель ИБ" Tag="Внутренний нарушитель ИБ" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="881" Canvas.Top="339" Width="95" Height="52" ToolTip="Мотивация нарушителя" Tag="Мотивация нарушителя" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="881" Canvas.Top="538" Width="95" Height="53" ToolTip="Цели нарушителя" Tag="Цели нарушителя" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="763" Canvas.Top="652" Width="95" Height="52" ToolTip="Нарушение доступности данных" Tag="Нарушение доступности данных" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="881" Canvas.Top="652" Width="95" Height="53" ToolTip="Нанесение ущерба ИЦ (организации)" Tag="Нанесение ущерба ИЦ (организации)" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="997" Canvas.Top="651" Width="95" Height="52" ToolTip="Нарушение работы АС" Tag="Нарушение работы АС" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="821" Canvas.Top="756" Width="95" Height="53" ToolTip="НСД к информации" Tag="НСД к информации" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="943" Canvas.Top="756" Width="95" Height="53" ToolTip="Хищение, модификация информации" Tag="Хищение, модификация информации" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />

                                <!-- Верхний центр: мотивация -->
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="507" Canvas.Top="32" Width="107" Height="60" ToolTip="Защищаемая информация о продукте компании" Tag="Защищаемая информация о продукте компании" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="630" Canvas.Top="30" Width="108" Height="60" ToolTip="Данные о внутреннем положении организации" Tag="Данные о внутреннем положении организации" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="875" Canvas.Top="31" Width="107" Height="59" ToolTip="Перепродажа украденной информации" Tag="Перепродажа украденной информации" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="991" Canvas.Top="32" Width="107" Height="59" ToolTip="Вынудить за устранение последствий вмешательства" Tag="Вынудить за устранение последствий вмешательства" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1115" Canvas.Top="31" Width="107" Height="60" ToolTip="Запугать оппонентов (народ)" Tag="Запугать оппонентов (народ)" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1238" Canvas.Top="31" Width="107" Height="60" ToolTip="Очернить оппонентов с помощью компромата" Tag="Очернить оппонентов с помощью компромата" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="630" Canvas.Top="139" Width="108" Height="53" ToolTip="Промышленный шпионаж" Tag="Промышленный шпионаж" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="756" Canvas.Top="144" Width="109" Height="48" ToolTip="Государственный шпионаж" Tag="Государственный шпионаж" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="991" Canvas.Top="140" Width="107" Height="52" ToolTip="Материальная (финансовая) выгода" Tag="Материальная (финансовая) выгода" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1115" Canvas.Top="141" Width="105" Height="52" ToolTip="Политическая, идеологическая" Tag="Политическая, идеологическая" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="763" Canvas.Top="239" Width="95" Height="54" ToolTip="Шпионаж" Tag="Шпионаж" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="881" Canvas.Top="239" Width="95" Height="54" ToolTip="Исследования" Tag="Исследования" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="997" Canvas.Top="240" Width="95" Height="54" ToolTip="Выгода" Tag="Выгода" Click="SchemeNodeButton_Click" />

                                <!-- Правая синяя группа -->
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1151" Canvas.Top="339" Width="106" Height="52" ToolTip="Преднамеренный нарушитель" Tag="Преднамеренный нарушитель" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" >
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-0.282"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                </Button>
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1152" Canvas.Top="538" Width="106" Height="54" ToolTip="Непреднамеренный нарушитель" Tag="Непреднамеренный нарушитель" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1359" Canvas.Top="83" Width="106" Height="86" ToolTip="(вредоносный) Администратор" Tag="(вредоносный) Администратор" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1359" Canvas.Top="196" Width="106" Height="86" ToolTip="Пользователь (Инсайдер)" Tag="Пользователь (Инсайдер)" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1359" Canvas.Top="307" Width="106" Height="84" ToolTip="Злоупотребляющий пользователь" Tag="Злоупотребляющий пользователь" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1517" Canvas.Top="14" Width="106" Height="86" ToolTip="Администратор инфраструктуры" Tag="Администратор инфраструктуры" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1674" Canvas.Top="14" Width="111" Height="85" ToolTip="Администратор безопасности" Tag="Администратор безопасности" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1517" Canvas.Top="160" Width="106" Height="85" ToolTip="Финансово мотивированный" Tag="Финансово мотивированный" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1674" Canvas.Top="160" Width="110" Height="86" ToolTip="Идеологически мотивированный" Tag="Идеологически мотивированный" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1517" Canvas.Top="307" Width="106" Height="85" ToolTip="Пользователь с расширенными правами" Tag="Пользователь с расширенными правами" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1674" Canvas.Top="307" Width="107" Height="85" ToolTip="Пользователь с накопленными правами" Tag="Пользователь с накопленными правами" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5" >
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="-0.262"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                </Button>
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1359" Canvas.Top="507" Width="106" Height="85" ToolTip="Некомпетентный пользователь" Tag="Некомпетентный пользователь" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1359" Canvas.Top="620" Width="106" Height="85" ToolTip="Невнимательный пользователь" Tag="Невнимательный пользователь" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Top" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1359" Canvas.Top="734" Width="106" Height="84" ToolTip="Скомпрометированный пользователь" Tag="Скомпрометированный пользователь" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1517" Canvas.Top="506" Width="106" Height="86" ToolTip="Новые сотрудники" Tag="Новые сотрудники" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1662" Canvas.Top="506" Width="107" Height="86" ToolTip="Внешние подрядчики" Tag="Внешние подрядчики" Click="SchemeNodeButton_Click" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1511" Canvas.Top="734" Width="106" Height="85" ToolTip="Скомпрометирован через фишинг, соц инженерию" Tag="Скомпрометирован через фишинг, соц инженерию" Click="SchemeNodeButton_Click" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <Button Style="{StaticResource SchemeHotspotButtonStyle}" Canvas.Left="1663" Canvas.Top="734" Width="105" Height="85" ToolTip="Скомпрометирован через ВПО" Tag="Скомпрометирован через ВПО" Click="SchemeNodeButton_Click" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" >
                                    <Button.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform/>
                                            <SkewTransform/>
                                            <RotateTransform Angle="0.054"/>
                                            <TranslateTransform/>
                                        </TransformGroup>
                                    </Button.RenderTransform>
                                </Button>
                                </Canvas>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Column="1"
                                Padding="12"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FAFAFA">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Информация по выбранному блоку"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="SchemeNodeInfoTitle"
                                           DockPanel.Dock="Top"
                                           Text="Выберите блок схемы"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#1F4E79"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="SchemeNodeInfoDescription"
                                               Text="Нажмите на любой блок схемы модели нарушителей, чтобы увидеть его пояснение и роль в модели."
                                               FontSize="13"
                                               Foreground="#333"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Grid.Column="1"
                    Margin="106,0,0,0">
            <Button Style="{StaticResource OutlinedGrayButtonStyle}"
                    Content="Добавить"
                    Command="{Binding AddCommand}" />

            <Button Style="{StaticResource OutlinedGrayButtonStyle}"
                    Content="Удалить"
                    Command="{Binding DeleteCommand}" />

            <Button Style="{StaticResource OutlinedGrayButtonStyle}"
                    Content="Изменить"
                    Command="{Binding ChangeCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
