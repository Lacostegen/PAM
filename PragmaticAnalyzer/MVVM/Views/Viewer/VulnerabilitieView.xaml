<UserControl Foreground="{DynamicResource WorkspaceText}" x:Class="PragmaticAnalyzer.MVVM.Views.Viewer.VulnerabilitieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PragmaticAnalyzer.MVVM.Views"
             xmlns:assist="clr-namespace:PragmaticAnalyzer.Assistant"
             xmlns:vmViewer="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Viewer"
             xmlns:view="clr-namespace:PragmaticAnalyzer.MVVM.Views.Viewer"
             xmlns:cc="clr-namespace:PragmaticAnalyzer.CastomControls"
             d:DataContext="{d:DesignInstance Type=vmViewer:VulnerabilitieViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="1000">
    <UserControl.Resources>
        <assist:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <assist:EnumDescriptionConverter x:Key="EnumDescriptionConverter" />
        <assist:VulnerabilityCaptionConverter x:Key="VulnerabilityCaption"/>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <Grid Background="#142025" MinWidth="654" Width="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.85*" MinWidth="192"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*" MinWidth="318"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="0.3*" MinWidth="132"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <GridSplitter Grid.Column="1" Grid.RowSpan="4" Style="{StaticResource PaneDivider}" ToolTip="Ширина списка уязвимостей"/>
        <GridSplitter Grid.Column="3" Grid.RowSpan="4" Style="{StaticResource PaneDivider}" ToolTip="Ширина панели состояния"/>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Foreground="#DCEDEA" Text="{Binding DisplayedVulnerabilities.Count, StringFormat=Записей: {0}}"
                   Style="{StaticResource MainTextBlockStyle}" />

        <DataGrid Grid.Row="1" Margin="4" Background="#19282E" Foreground="#E4F2F0"
                  RowBackground="#19282E" AlternatingRowBackground="#1C2E34" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#34494F" BorderBrush="#456068" HeadersVisibility="Column"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserResizeColumns="True" EnableRowVirtualization="True" RowHeight="32" ItemsSource="{Binding DisplayedVulnerabilities}"
                  SelectedItem="{Binding SelectedVulnerabilitie, Mode=TwoWay}">
            <DataGrid.Resources>
                <Style x:Key="RecordCell" TargetType="TextBlock">
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Margin" Value="4,0"/>
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                </Style>
                <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#263B42"/><Setter Property="Foreground" Value="White"/><Setter Property="Padding" Value="5"/></Style>
            </DataGrid.Resources>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Идентификатор" Binding="{Binding Identifier}" Width="120" MinWidth="70" ElementStyle="{StaticResource RecordCell}"/>
                <DataGridTextColumn Header="Название / описание" Width="*" MinWidth="72" ElementStyle="{StaticResource RecordCell}">
                    <DataGridTextColumn.Binding>
                        <Binding Converter="{StaticResource VulnerabilityCaption}"/>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <ComboBox Grid.Row="2"
                  Grid.Column="0"
                  ItemsSource="{Binding NamesDatabases}"
                  SelectedItem="{Binding SelectedDatabase}"
                  Style="{StaticResource RoundedComboBoxStyle}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <ContentControl Grid.Row="0"
                        Grid.Column="2"
                        Content="{Binding LocalSearch}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

        <Border Grid.Row="1"
                Grid.Column="2"
                Grid.RowSpan="3"
                Margin="5"
                BorderBrush="#39525A"
                BorderThickness="1"
                CornerRadius="6">
            <ContentControl Content="{Binding CurrentView}"
                            Margin="5">
                <FrameworkElement.Resources>
                    <DataTemplate DataType="{x:Type vmViewer:VulnerabilitieFstecViewModel}">
                        <view:VulnerabilitieFstecView />
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type vmViewer:VulnerabilitieNvdViewModel}">
                        <view:VulnerabilitieNvdView />
                    </DataTemplate>
                    
                    <DataTemplate DataType="{x:Type vmViewer:VulnerabilitieJvnViewModel}">
                        <view:VulnerabilitieJvnView />
                    </DataTemplate>
                </FrameworkElement.Resources>
            </ContentControl>
        </Border>
      
        <Button Grid.Row="3"
                Grid.Column="0"
                Content="Обновить"
                Style="{StaticResource  OutlinedGrayButtonStyle}"
                Command="{Binding UpdateCommand}" />

        <TextBlock Grid.Row="0"
                   Grid.Column="4"
                   Foreground="#DCEDEA" Text="Ход выполнения:"
                   Style="{StaticResource MainTextBlockStyle}" />

        <cc:FramedTextBlock Grid.Row="1"
                            Grid.Column="4"
                            Text="{Binding Status}" />

        <ProgressBar Grid.Row="2"
                     Grid.Column="4"
                     Style="{StaticResource RoundedProgressBarStyle}"
                     IsIndeterminate="{Binding Progress}" />

        <Button Grid.Row="3"
                Grid.Column="4"
                Content="Остановить"
                Style="{StaticResource OutlinedGrayButtonStyle}"
                Command="{Binding CancelUpdateCommand}" />
    </Grid>
    </ScrollViewer>
</UserControl>
