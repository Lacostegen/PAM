<UserControl x:Class="PragmaticAnalyzer.MVVM.Views.Viewer.ThreatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PragmaticAnalyzer.MVVM.Views"
             xmlns:cc="clr-namespace:PragmaticAnalyzer.CastomControls"
             xmlns:assist="clr-namespace:PragmaticAnalyzer.Assistant"
             xmlns:vmViewer="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Viewer"
             d:DataContext="{d:DesignInstance Type=vmViewer:ThreatViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             Loaded="ThreatView_Loaded">
    <UserControl.Resources>
        <assist:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />

        <Style x:Key="ThreatSchemeHotspotButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#E8F0D4" />
            <Setter Property="BorderBrush" Value="#222222" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="2,0" />
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D5E9FF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF007ACC" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B8DCFF" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#FF005A9E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="44" />
            <RowDefinition Height="44" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.Column="0"
                    Margin="5,5,5,0">
            <TextBlock Text="Идентификатор угрозы:"
                       Style="{StaticResource MainTextBlockStyle}" />

            <Button x:Name="ThreatSchemeToggleButton"
                    Content="Схема модели угроз"
                    Style="{StaticResource OutlinedGrayButtonStyle}"
                    Margin="0,5,0,0"
                    Padding="6,4"
                    Click="ToggleThreatSchemeButton_Click" />
        </StackPanel>

        <TextBlock Grid.Row="0"
                   Grid.Column="2"
                   Text="Ход выполнения:"
                   Style="{StaticResource MainTextBlockStyle}" />

        <ContentControl Grid.Row="0"
                        Grid.Column="1"
                        Content="{Binding LocalSearch}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

        <ListBox x:Name="ThreatIdentifiersListBox"
                 Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding Threats, Mode=OneWay}"
                 Style="{StaticResource RoundedListBoxStyle}"
                 ItemContainerStyle="{StaticResource RoundedListBoxItemStyle}"
                 SelectedItem="{Binding SelectedThreat}"
                 VirtualizingStackPanel.IsVirtualizing="True"
                 VirtualizingStackPanel.VirtualizationMode="Recycling">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Id}"
                               Style="{StaticResource MainTextBlockStyle}"
                               Margin="1" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border x:Name="ThreatContentBorder"
                Grid.Row="1"
                Grid.Column="1"
                Grid.RowSpan="3"
                Margin="5"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="6"
                Panel.ZIndex="1">
            <Grid>
                <ScrollViewer x:Name="ThreatCardsPanel"
                              Margin="5"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <WrapPanel Visibility="{Binding SelectedThreat, Converter={StaticResource NullToVisibilityConverter}}">
                        <cc:LabeledValueBox LabelText="Наименование УБИ"
                                            ValueText="{Binding SelectedThreat.Name}" />

                        <cc:LabeledValueBox LabelText="Описание"
                                            ValueText="{Binding SelectedThreat.Description}" />

                        <cc:LabeledValueBox LabelText="Источник угрозы (характеристика и потенциал нарушителя)"
                                            ValueText="{Binding SelectedThreat.Source}" />

                        <cc:LabeledValueBox LabelText="Объект воздействия"
                                            ValueText="{Binding SelectedThreat.ObjectInfluence}" />

                        <cc:LabeledValueBox LabelText="Нарушение конфиденциальности"
                                            ValueText="{Binding SelectedThreat.PrivacyViolation}" />

                        <cc:LabeledValueBox LabelText="Нарушение целостности"
                                            ValueText="{Binding SelectedThreat.IntegrityViolation}" />

                        <cc:LabeledValueBox LabelText="Нарушение доступности"
                                            ValueText="{Binding SelectedThreat.AccessibilityViolation}" />

                        <cc:LabeledValueBox LabelText="Дата включения угрозы в БнД УБИ"
                                            ValueText="{Binding SelectedThreat.DateInclusion}" />

                        <cc:LabeledValueBox LabelText="Дата последнего изменения данных"
                                            ValueText="{Binding SelectedThreat.DateChange}" />
                    </WrapPanel>
                </ScrollViewer>

                <Grid x:Name="ThreatSchemePanel"
                      Visibility="Collapsed"
                      d:Visibility="Visible"
                      Background="White"
                      PreviewMouseWheel="ThreatSchemeScrollViewer_PreviewMouseWheel">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="8"
                               LastChildFill="False">
                        <TextBlock Text="Схема модели угроз информационной безопасности"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   Style="{StaticResource MainTextBlockStyle}" />

                        <Button Content="Вернуться к карточке"
                                DockPanel.Dock="Right"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Margin="5,0,0,0"
                                Click="HideThreatSchemeButton_Click" />

                        <Button Content="100%"
                                DockPanel.Dock="Right"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Margin="5,0,0,0"
                                Click="ResetThreatSchemeZoomButton_Click" />

                    </DockPanel>

                    <Grid Grid.Row="1"
                          Margin="8,4,8,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <ScrollViewer x:Name="ThreatSchemeScrollViewer"
                                      Grid.Column="0"
                                      Margin="0,0,8,0"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      Background="White"
                                      PreviewMouseWheel="ThreatSchemeScrollViewer_PreviewMouseWheel">
                            <Grid Width="3200"
                                  Height="1221"
                                  Background="White">
                                <Grid.LayoutTransform>
                                    <ScaleTransform x:Name="ThreatSchemeScaleTransform"
                                                    ScaleX="1"
                                                    ScaleY="1"
                                                    d:ScaleX="0.22"
                                                    d:ScaleY="0.22" />
                                </Grid.LayoutTransform>

                                <Canvas x:Name="ThreatSchemeLinesCanvas"
                                        Width="3200"
                                        Height="1221"
                                        IsHitTestVisible="False" />

                                <Canvas x:Name="ThreatSchemeHotspotsCanvas"
                                        Width="3200"
                                        Height="1221" />
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Column="1"
                                Padding="12"
                                BorderBrush="#BDBDBD"
                                BorderThickness="1"
                                CornerRadius="6"
                                Background="#FAFAFA">
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Информация по выбранному блоку"
                                           FontWeight="Bold"
                                           FontSize="15"
                                           Margin="0,0,0,10"
                                           TextWrapping="Wrap" />

                                <TextBlock x:Name="ThreatSchemeNodeInfoTitle"
                                           DockPanel.Dock="Top"
                                           Text="Выберите блок схемы"
                                           FontWeight="SemiBold"
                                           FontSize="14"
                                           Foreground="#1F4E79"
                                           Margin="0,0,0,8"
                                           TextWrapping="Wrap" />

                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="ThreatSchemeNodeInfoDescription"
                                               Text="Нажмите на любой блок схемы модели угроз, чтобы увидеть пояснение и типовые последствия для ИБ."
                                               FontSize="13"
                                               Foreground="#333"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <cc:FramedTextBlock Grid.Row="1"
                            Grid.Column="2"
                            Grid.RowSpan="2"
                            Text="{Binding Status}" />

        <ProgressBar Grid.Row="2"
                     Grid.Column="0"
                     Style="{StaticResource RoundedProgressBarStyle}"
                     IsIndeterminate="{Binding Progress}" />

        <Button Grid.Row="3"
                Grid.Column="0"
                Content="Обновить"
                Style="{StaticResource OutlinedGrayButtonStyle}"
                Command="{Binding UpdateCommand}" />

        <Button Grid.Row="3"
                Grid.Column="2"
                Content="Остановить"
                Style="{StaticResource OutlinedGrayButtonStyle}"
                Command="{Binding CancelUpdateCommand}" />
    </Grid>
</UserControl>
