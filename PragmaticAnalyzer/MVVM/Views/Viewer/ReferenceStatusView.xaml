<UserControl x:Class="PragmaticAnalyzer.MVVM.Views.Viewer.ReferenceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:cc="clr-namespace:PragmaticAnalyzer.CastomControls"
             xmlns:assist="clr-namespace:PragmaticAnalyzer.Assistant"
             xmlns:vmViewer="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Viewer"
             d:DataContext="{d:DesignInstance Type=vmViewer:ReferenceStatusViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <assist:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Grid.Column="0"
                   Text="Эталонное состояние:"
                   Style="{StaticResource MainTextBlockStyle}" />

        <ContentControl Grid.Row="0"
                        Grid.Column="1"
                        Content="{Binding LocalSearch}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center" />

        <ListBox Grid.Row="1"
                 Grid.Column="0"
                 ItemsSource="{Binding ReferencesStatus}"
                 SelectedItem="{Binding SelectedReferenceStatus}"
                 Style="{StaticResource RoundedListBoxStyle}"
                 ItemContainerStyle="{StaticResource RoundedListBoxItemStyle}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding NameSoftware}"
                               Style="{StaticResource MainTextBlockStyle}"
                               Margin="1" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1"
                Grid.Column="1"
                Margin="5"
                BorderBrush="Black"
                BorderThickness="1"
                CornerRadius="6">
            <WrapPanel Visibility="{Binding SelectedReferenceStatus, Converter={StaticResource NullToVisibilityConverter}}">
                <cc:LabeledValueBox LabelText="Эталонное состояние"
                                    ValueText="{Binding SelectedReferenceStatus.NameSoftware}" />

                <cc:LabeledValueBox LabelText="Время поступления ПД в систему"
                                    ValueText="{Binding SelectedReferenceStatus.ArrivalTime}" />
            </WrapPanel>
        </Border>
    </Grid>
</UserControl>
