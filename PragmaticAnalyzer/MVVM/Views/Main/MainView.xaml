<Window Foreground="{DynamicResource WorkspaceText}" x:Class="PragmaticAnalyzer.MVVM.Views.Main.MainView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vmMain="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Main"
        xmlns:vmViewer="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Viewer"
        xmlns:vmAlg="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.AlgorithmInformation"
        xmlns:viewMain="clr-namespace:PragmaticAnalyzer.MVVM.Views.Main"
        xmlns:viewViewer="clr-namespace:PragmaticAnalyzer.MVVM.Views.Viewer"
        xmlns:viewAlg="clr-namespace:PragmaticAnalyzer.MVVM.Views.AlgorithmInformation"
        xmlns:assist="clr-namespace:PragmaticAnalyzer.Assistant"
        d:DataContext="{d:DesignInstance Type=vmMain:MainViewModel}"
        mc:Ignorable="d"
        PreviewMouseWheel="Window_MouseWheel" FontFamily="Segoe UI" Background="#10181C" Width="1280"
        Height="720"
        MinHeight="540"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="Система поддержки принятия решения специалистом по ЗИ v. 1.0">
    <Window.Resources>
        <assist:CurrentViewEqualsConverter x:Key="CurrentViewEqualsConverter" />

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource OutlinedGrayButtonStyle}">
            <Setter Property="Background"
                    Value="#172327" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Foreground" Value="#E4EFEF" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Margin" Value="4,2" /><Setter Property="Height" Value="38" /><Setter Property="Padding" Value="9,4" />
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <MultiBinding Converter="{StaticResource CurrentViewEqualsConverter}">
                            <Binding Path="CurrentView" />
                            <Binding RelativeSource="{RelativeSource Self}"
                                     Path="Tag" />
                        </MultiBinding>
                    </DataTrigger.Binding>
                    <Setter Property="Background"
                            Value="#163D35" />
                    <Setter Property="BorderBrush"
                            Value="#3CE4B4" />
                    <Setter Property="BorderThickness"
                            Value="2" />
                    <Setter Property="Foreground"
                            Value="#62F5CB" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="Shell">
        <Grid.LayoutTransform><ScaleTransform x:Name="ShellZoom"/></Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="202" MinWidth="162" MaxWidth="320"/>
            <ColumnDefinition Width="5"/>
            <ColumnDefinition MinWidth="200"/>
        </Grid.ColumnDefinitions>
        <DockPanel Background="#172327" ClipToBounds="True">
            <TextBlock DockPanel.Dock="Top" Text="PragmaticAnalyzer" FontSize="18" FontWeight="SemiBold" Foreground="#58F2C8" Margin="12,20,12,16"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                <Button Content="Загрузить БД"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.SetVm}"
                        Tag="{Binding ViewModelsService.SetVm}" />

                <Button Content="Работа с БД"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.ViewerVm}"
                        Tag="{Binding ViewModelsService.ViewerVm}" />

                <Button Content="Работа с онтологиями"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.OntologyVm}"
                        Tag="{Binding ViewModelsService.OntologyVm}" />

                <Button Content="Работа с моделями"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.SettingVm}"
                        Tag="{Binding ViewModelsService.SettingVm}" />

                <Button Content="Работа с ИЗ"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.CreatorVm}"
                        Tag="{Binding ViewModelsService.CreatorVm}" />

                <Button Content="Сформировать отчет"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.ConnectionVm}"
                        Tag="{Binding ViewModelsService.ConnectionVm}" />

                <Button Content="Общение с моделью"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.CommunicationVm}"
                        Tag="{Binding ViewModelsService.CommunicationVm}" />

                <Button Content="Информация"
                        Style="{StaticResource NavigationButtonStyle}"
                        Command="{Binding SetCurrentViewCommand}"
                        CommandParameter="{Binding ViewModelsService.InformationVm}"
                        Tag="{Binding ViewModelsService.InformationVm}" />
            </StackPanel></ScrollViewer>
        </DockPanel>
        <GridSplitter Grid.Column="1" Style="{StaticResource PaneDivider}" ToolTip="Ширина меню разделов"/>
        <Border Grid.Column="2" ClipToBounds="True" Background="{DynamicResource WorkspaceCanvas}">
            <ContentControl Content="{Binding CurrentView}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <FrameworkElement.Resources>
                    <DataTemplate DataType="{x:Type vmMain:SetViewModel}">
                        <viewMain:SetView />
                    </DataTemplate>
                    <!--Загрузить БД-->

                    <DataTemplate DataType="{x:Type vmMain:ViewerViewModel}">
                        <viewMain:ViewerView />
                    </DataTemplate>
                    <!--Работа с БД-->

                    <DataTemplate DataType="{x:Type vmMain:DatabaseSearchResultsViewModel}">
                        <viewMain:DatabaseSearchResultsView />
                    </DataTemplate>
                    <!--Результаты поиска по БД-->

                    <DataTemplate DataType="{x:Type vmMain:DatabaseSearchDetailsViewModel}">
                        <viewMain:DatabaseSearchDetailsView />
                    </DataTemplate>
                    <!--Полный результат поиска по БД-->

                    <DataTemplate DataType="{x:Type vmMain:LocalDatabaseSearchViewModel}">
                        <viewMain:DatabaseLocalSearchBarView />
                    </DataTemplate>
                    <!--Локальный поиск по текущей БД-->

                    <DataTemplate DataType="{x:Type vmMain:OntologyViewModel}">
                        <viewMain:OntologyView />
                    </DataTemplate>
                    <!--Работа с онтологиями-->

                    <DataTemplate DataType="{x:Type vmMain:SettingViewModel}">
                        <viewMain:SettingView />
                    </DataTemplate>
                    <!--Работа с моделями-->

                    <DataTemplate DataType="{x:Type vmMain:CreatorViewModel}">
                        <viewMain:CreatorView />
                    </DataTemplate>
                    <!--Работа с ИЗ-->

                    <DataTemplate DataType="{x:Type vmMain:ConnectionViewModel}">
                        <viewMain:ConnectionView />
                    </DataTemplate>
                    <!--Сформировать отчет-->

                    <DataTemplate DataType="{x:Type vmMain:CommunicationViewModel}">
                        <viewMain:CommunicationView />
                    </DataTemplate>
                    <!--Общение с моделью-->

                    <DataTemplate DataType="{x:Type vmMain:InformationViewModel}">
                        <viewMain:InformationView />
                    </DataTemplate>
                    <!--Информация-->

                    <DataTemplate DataType="{x:Type vmViewer:VulnerabilitieViewModel}">
                        <viewViewer:VulnerabilitieView />
                    </DataTemplate>
                    <!--Уязвимости-->

                    <DataTemplate DataType="{x:Type vmViewer:ThreatViewModel}">
                        <viewViewer:ThreatView />
                    </DataTemplate>
                    <!--Угрозы-->

                    <DataTemplate DataType="{x:Type vmViewer:TacticViewModel}">
                        <viewViewer:TacticView />
                    </DataTemplate>
                    <!--Техники и тактики-->

                    <DataTemplate DataType="{x:Type vmViewer:OutcomesViewModel}">
                        <viewViewer:OutcomesView />
                    </DataTemplate>
                    <!--Риски (Исходы)-->

                    <DataTemplate DataType="{x:Type vmViewer:ProtectionMeasureViewModel}">
                        <viewViewer:ProtectionMeasureView />
                    </DataTemplate>
                    <!--Меры защиты-->

                    <DataTemplate DataType="{x:Type vmViewer:ExploitViewModel}">
                        <viewViewer:ExploitView />
                    </DataTemplate>
                    <!--Эксплойты-->

                    <DataTemplate DataType="{x:Type vmViewer:ViolatorViewModel}">
                        <viewViewer:ViolatorView />
                    </DataTemplate>
                    <!--Нарушители-->

                    <DataTemplate DataType="{x:Type vmViewer:SpecialistViewModel}">
                        <viewViewer:SpecialistView />
                    </DataTemplate>
                    <!--Специалист-->

                    <DataTemplate DataType="{x:Type vmViewer:CurrentStatusViewModel}">
                        <viewViewer:CurrentStatusView />
                    </DataTemplate>
                    <!--Текущее состояние-->

                    <DataTemplate DataType="{x:Type vmViewer:ReferenceStatusViewModel}">
                        <viewViewer:ReferenceStatusView />
                    </DataTemplate>
                    <!--Эталонное состояние-->

                    <DataTemplate DataType="{x:Type vmAlg:FastTextInformationViewModel}">
                        <viewAlg:FasttextInformationView />
                    </DataTemplate>
                    <!--Алгоритм Fasttext-->

                    <DataTemplate DataType="{x:Type vmAlg:WordTwoVecInformationViewModel}">
                        <viewAlg:WordTwoVectInformationView />
                    </DataTemplate>
                    <!--Алгоритм Word2Vec-->

                    <DataTemplate DataType="{x:Type vmAlg:TfIdfInformationViewModel}">
                        <viewAlg:TfIdfInformationView />
                    </DataTemplate>
                    <!--Алгоритм Tf-Idf-->
                </FrameworkElement.Resources>
            </ContentControl>
        </Border>
    </Grid>
</Window>
