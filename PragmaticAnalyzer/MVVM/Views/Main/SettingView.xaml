<UserControl Foreground="{DynamicResource WorkspaceText}" x:Class="PragmaticAnalyzer.MVVM.Views.Main.SettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PragmaticAnalyzer.MVVM.Views"
             xmlns:vm="clr-namespace:PragmaticAnalyzer.MVVM.ViewModel.Main"
             d:DataContext="{d:DesignInstance vm:SettingViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="260" />
                <RowDefinition Height="260" />
                <RowDefinition Height="210" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Margin="5"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WorkspaceLine}">
                <Grid  Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="5">
                        <TextBlock Text="Настройка моделей Word2Vec"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   FontFamily="Segoe UI" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  ItemsSource="{Binding WordTwoVecConfigs}"
                                  SelectedItem="{Binding SelectedWordTwoVecConfig}"
                                  IsEnabled="{Binding HasWordTwoVecModels}"
                                  MinHeight="32"
                                  MaxDropDownHeight="260"
                                  ToolTip="Список загруженных Word2Vec-моделей">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayedName}" />
                                        <TextBlock Text=" — используется"
                                                   Visibility="{Binding IsUsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Foreground="{DynamicResource WorkspaceMuted}"
                                                   Margin="5,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Content="Загрузить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding UploadWordTwoVecModelCommand}" />

                        <Button Grid.Column="2"
                                Content="Обучить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding TrainWordTwoVecModelCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Column="0"
                                     Style="{StaticResource RoundedProgressBarStyle}"
                                     IsIndeterminate="{Binding ProgressWordTwoVec}" />

                        <Button Grid.Column="1"
                                Content="Использовать модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding UseWordTwoVecModelCommand}" />

                        <Button Grid.Column="2"
                                Content="Удалить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding DeleteWordTwoVecModelCommand}" />

                        <Button Grid.Column="3"
                                Content="Дообучить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding RetrainWordTwoVecModelCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="{Binding WordTwoVecStatusText}"
                               Margin="8,2,8,6"
                               Foreground="{DynamicResource WorkspaceMuted}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="5"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WorkspaceLine}">
                <Grid  Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="5">
                        <TextBlock Text="Настройка моделей FastText"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   FontFamily="Segoe UI" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0"
                                  Style="{StaticResource RoundedComboBoxStyle}"
                                  ItemsSource="{Binding FastTextConfigs}"
                                  SelectedItem="{Binding SelectedFastTextConfig, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding HasFastTextModels}"
                                  MinHeight="32"
                                  MaxDropDownHeight="260"
                                  ToolTip="Список загруженных FastText-моделей">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayedName}" />
                                        <TextBlock Text=" — используется"
                                                   Visibility="{Binding IsUsed, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                   Foreground="{DynamicResource WorkspaceMuted}"
                                                   Margin="5,0,0,0" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <Button Grid.Column="1"
                                Content="Загрузить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding UploadFastTextModelCommand}" />

                        <Button Grid.Column="2"
                                Content="Обучить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding TrainFastTextModelCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Column="0"
                                     Style="{StaticResource RoundedProgressBarStyle}"
                                     IsIndeterminate="{Binding ProgressFastText}" />

                        <Button Grid.Column="1"
                                Content="Использовать модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding UseFastTextModelCommand}" />

                        <Button Grid.Column="2"
                                Content="Удалить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding DeleteFastTextModelCommand}" />

                        <Button Grid.Column="3"
                                Content="Дообучить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding RetrainFastTextModelCommand}" />
                    </Grid>

                    <TextBlock Grid.Row="3"
                               Text="{Binding FastTextStatusText}"
                               Margin="8,2,8,6"
                               Foreground="{DynamicResource WorkspaceMuted}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Margin="5"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource WorkspaceLine}">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="5">
                        <TextBlock Text="Настройка модели GloVe + CVSS"
                                   VerticalAlignment="Center"
                                   FontSize="30"
                                   FontFamily="Segoe UI" />
                    </Grid>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition />
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Готовый комплект: glove_vectors.bin, glove_word_index.json, glove_shape.json"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   FontSize="15"
                                   FontFamily="Segoe UI"
                                   Foreground="{DynamicResource WorkspaceText}" />

                        <Button Grid.Column="1"
                                Content="Загрузить комплект"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding UploadGloVeModelCommand}" />

                        <Button Grid.Column="2"
                                Content="Проверить модель"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding VerifyGloVeModelCommand}" />

                        <Button Grid.Column="3"
                                Content="Открыть папку"
                                Style="{StaticResource OutlinedGrayButtonStyle}"
                                Command="{Binding OpenGloVeFolderCommand}" />
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <ProgressBar Grid.Column="0"
                                     Style="{StaticResource RoundedProgressBarStyle}"
                                     IsIndeterminate="{Binding ProgressGloVe}" />

                        <TextBlock Grid.Column="1"
                                   Text="{Binding GloVeStatusText}"
                                   Margin="8,2,8,6"
                                   Foreground="{DynamicResource WorkspaceMuted}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
